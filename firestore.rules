rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
// Class-Track Firestore Güvenlik Kuralları
// ═══════════════════════════════════════════════════════════════════
// 🔐 YÖNETİCİ (ADMIN) UID: oSujlr09TDZ10zk3QU8LMdpy1Ti2
// Sadece bu UID'ye sahip hesap pending_users koleksiyonuna
// yazabilir (kullanıcı ekleme/silme/düzenleme).
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yardımcı Fonksiyonlar ─────────────────────────────────────
    // Ana yönetici kontrolü: Sadece belirtilen UID'ye sahip kullanıcı
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'oSujlr09TDZ10zk3QU8LMdpy1Ti2';
    }

    // ─── pending_users: KULLANICI EKLEME/SİLME/DÜZENLEME ───────────
    // 🔐 KİLİTLİ: Sadece ana yönetici (Admin) yazabilir.
    //    - create/update: Sadece Admin
    //    - delete: Sadece Admin VEYA kullanıcının kendi kaydı
    //      (LoginPage'deki ilk giriş aktivasyon akışı için)
    //    - read: Admin VEYA herhangi bir kullanıcı (auth olsun olmasın)
    //      ⚠️ GÜVENLİK NOTU: Auth olmayan kullanıcıların okumasına izin
    //      verildiği için tempPassword alanı herkes tarafından okunabilir.
    //      Üretim ortamında bu akışı Firebase Cloud Function ile
    //      değiştirmeniz önerilir.
    match /pending_users/{email} {
      allow read: if isAdmin() || request.auth == null || (request.auth != null && request.auth.token.email == email);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && request.auth.token.email == email);
    }

    // ─── Diğer Koleksiyonlar ───────────────────────────────────────
    // Mevcut uygulama akışını korur: Oturum açmış tüm kullanıcılar
    // okuyup yazabilir. (pending_users kuralı daha spesifik olduğu
    // için bu genel kuralı ezer.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}